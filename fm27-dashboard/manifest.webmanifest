{
  "name": "FM27 Manager Dashboard",
  "short_name": "FM27 Dashboard",
  "description": "Begleit-Tool zu Football Manager: Kader, Taktik, Transfers, Finanzen und Planung – alle Daten bleiben lokal auf deinem Gerät.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0f1117",
